# ===== frontend (presentation tier): the public website =====
# The website never connects to the database — it reads content from the backend's API.

# --- Required ---
# The backend (application tier) — content API, uploaded files, contact form
CMS_URL=http://localhost:3001
# This website's own public address (links, sitemap, social sharing)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Shared secret between frontend and backend (same value in backend/.env)
INTERNAL_API_SECRET=change-me-to-another-long-random-string

# --- Captcha (Google reCAPTCHA v3) site key. Leave empty in development to skip ---
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# --- Analytics ---
NEXT_PUBLIC_GA_ID=
