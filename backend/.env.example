# ===== backend (application tier): Payload CMS — admin panel + API =====

# --- Required ---
# The data tier. Locally: the same value as db/.env. In production: the hosted Postgres (e.g. Neon).
DATABASE_URI=postgresql://postgres:postgres@localhost:5432/rohan
PAYLOAD_SECRET=change-me-to-a-long-random-string
# This backend's own public address (admin panel, API, uploaded files)
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3001
# The public website (frontend tier) — previews, "View website" and cache refresh after edits
FRONTEND_URL=http://localhost:3000
# Shared secret between frontend and backend (same value in frontend/.env). Any long random text.
INTERNAL_API_SECRET=change-me-to-another-long-random-string

# --- Media storage (production on Vercel) ---
# When set, uploads go to Vercel Blob instead of the local backend/media folder
BLOB_READ_WRITE_TOKEN=

# --- Email (form notifications + auto-acknowledgements) ---
RESEND_API_KEY=
EMAIL_FROM=Rohan Deshmukh <noreply@rohandeshmukh.in>

# --- Captcha (Google reCAPTCHA v3) secret. Leave empty in development to skip ---
RECAPTCHA_SECRET_KEY=

# --- Seed: where to pull images from the current site ---
LEGACY_SITE_URL=https://rohan-deshmukh-website.vercel.app
