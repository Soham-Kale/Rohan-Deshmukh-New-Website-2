{
  "name": "@rohan/backend",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Backend: Express + Sequelize REST API (SQLite for development, MySQL for production), admin authentication, uploads, forms and e-mail.",
  "main": "src/server.js",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "seed": "node src/seed/index.js --if-empty",
    "seed:fresh": "node src/seed/index.js --fresh",
    "migrate": "node src/db/migrate-cli.js",
    "import:payload": "node scripts/import-from-payload.mjs",
    "test": "node --test --test-concurrency=1 \"test/*.test.js\"",
    "lint": "eslint .",
    "admin": "node src/seed/admin.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "bcrypt": "^6.0.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.1",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "mysql2": "^3.24.6",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.1.7",
    "qs": "^6.16.1",
    "sanitize-html": "^2.18.1",
    "sequelize": "^6.37.8",
    "sharp": "^0.35.5",
    "sqlite3": "^6.0.1",
    "umzug": "^3.8.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.5",
    "globals": "^17.13.0"
  }
}
