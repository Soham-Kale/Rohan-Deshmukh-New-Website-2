{
  "name": "@rohan/backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Application tier: Payload CMS — admin panel, REST/GraphQL API, form handling, schema, migrations and seed. The only tier that talks to the database.",
  "scripts": {
    "dev": "cross-env NEXT_DIST_DIR=.next-dev next dev --turbopack -p 3001",
    "build": "next build",
    "start": "next start -p 3001",
    "typecheck": "tsc --noEmit",
    "payload": "payload",
    "generate:types": "payload generate:types",
    "generate:importmap": "payload generate:importmap",
    "seed": "node --env-file=.env --import tsx src/seed/index.ts",
    "seed:fresh": "node --env-file=.env --import tsx src/seed/index.ts --fresh",
    "seed:ci": "node --import tsx src/seed/index.ts",
    "migrate": "payload migrate",
    "migrate:create": "payload migrate:create",
    "menu:update": "node --env-file=.env --import tsx src/seed/apply-menu.ts",
    "content:update": "node --env-file=.env --import tsx src/seed/apply-menu.ts",
    "ci": "payload migrate && next build",
    "vercel-build": "payload migrate && npm run seed:ci && next build"
  },
  "dependencies": {
    "@fontsource/mukta": "^5.3.0",
    "@fontsource/tiro-devanagari-marathi": "^5.3.0",
    "@payloadcms/db-postgres": "^3.90.2",
    "@payloadcms/email-resend": "^3.90.2",
    "@payloadcms/next": "^3.90.2",
    "@payloadcms/plugin-import-export": "^3.90.2",
    "@payloadcms/plugin-search": "^3.90.2",
    "@payloadcms/plugin-seo": "^3.90.2",
    "@payloadcms/richtext-lexical": "^3.90.2",
    "@payloadcms/storage-vercel-blob": "^3.90.2",
    "@payloadcms/ui": "^3.90.2",
    "graphql": "^16.14.2",
    "marked": "^18.1.0",
    "next": "^15.4.11",
    "payload": "^3.90.2",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "cross-env": "^10.1.0",
    "dotenv": "^18.0.7",
    "node-html-parser": "^9.0.4",
    "sass": "^1.105.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
