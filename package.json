  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "payload": "payload",
    "generate:types": "payload generate:types",
    "generate:importmap": "payload generate:importmap",
    "seed": "node --env-file=.env --import tsx src/seed/index.ts",
    "seed:fresh": "node --env-file=.env --import tsx src/seed/index.ts --fresh",
    "migrate": "payload migrate",
    "migrate:create": "payload migrate:create",
    "ci": "payload migrate && next build",
    "seed:ci": "node --import tsx src/seed/index.ts",
    "vercel-build": "payload migrate && npm run seed:ci && next build",
    "dev:next": "next dev",
    "db": "node scripts/dev.mjs --db-only",
    "preview": "node scripts/dev.mjs --prod"
  },
  "engines": {
    "node": ">=20.9.0"
  },
