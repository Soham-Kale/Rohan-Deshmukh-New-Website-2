{
  "name": "rohan-deshmukh-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Three-tier website: frontend (public site) → backend (Payload CMS + API) → db (PostgreSQL)",
  "workspaces": [
    "db",
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "preview": "node scripts/dev.mjs --prod",
    "db": "npm run start -w db",
    "build": "npm run build -w backend && npm run build -w frontend",
    "build:backend": "npm run build -w backend",
    "build:frontend": "npm run build -w frontend",
    "seed": "npm run seed -w backend",
    "seed:fresh": "npm run seed:fresh -w backend",
    "migrate": "npm run migrate -w backend",
    "content:update": "npm run content:update -w backend",
    "generate:types": "npm run generate:types -w backend",
    "typecheck": "npm run typecheck -w backend && npm run typecheck -w frontend"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "dotenv": "^18.0.7",
    "pg": "^8.20.0"
  }
}
