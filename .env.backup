# --- Required ---
DATABASE_URI=postgresql://user:pass@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
PAYLOAD_SECRET=change-me-to-a-long-random-string
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Media storage (production on Vercel) ---
# When set, uploads go to Vercel Blob instead of the local /media folder
BLOB_READ_WRITE_TOKEN=

# --- Email (form notifications + auto-acknowledgements) ---
RESEND_API_KEY=
EMAIL_FROM=Rohan Deshmukh <noreply@rohandeshmukh.in>

# --- Captcha (Google reCAPTCHA v3). Leave empty in development to skip ---
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# --- Analytics ---
NEXT_PUBLIC_GA_ID=

# --- Seed: where to pull images from the current site ---
LEGACY_SITE_URL=https://rohan-deshmukh-website.vercel.app
